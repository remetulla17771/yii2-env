{
  "name": "deepn9x/yii2-env",
  "description": "Simple .env file loader extension for Yii2 framework",
  "type": "yii2-extension",
  "keywords": [
    "yii2",
    "env",
    "dotenv",
    "extension"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Remetulla DamiR",
      "email": "remetulla@gmail.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "yiisoft/yii2": "~2.0.0"
  },
  "autoload": {
    "psr-4": {
      "deepn9x\\env\\": "src/"
    }
  },
  "extra": {
    "bootstrap": "deepn9x\\env\\dotenv"
  }
}
